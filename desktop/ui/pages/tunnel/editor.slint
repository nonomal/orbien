import { Button, Switch } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Tr } from "../../i18n.slint";
import { FormField, FormPathField, FormCombo, FormRow } from "fields.slint";

export component TunnelEditor inherits Rectangle {
    in property <int> editing-index: -1;
    in-out property <string> edit-name: "";
    in-out property <string> edit-local-ip: "127.0.0.1";
    in-out property <string> edit-local-port: "8080";
    in-out property <string> edit-remote-port: "9000";
    in-out property <string> edit-domains: "";
    in-out property <string> edit-locations: "";
    in-out property <string> edit-basic-auth-user: "";
    in-out property <string> edit-basic-auth-password: "";
    in-out property <string> edit-host-header-rewrite: "";
    in-out property <string> edit-bandwidth-limit: "";
    in-out property <int> edit-bandwidth-side-index: 0;
    in-out property <int> edit-proxy-protocol-index: 0;
    in-out property <bool> edit-plugin-tls-term: false;
    in-out property <string> edit-plugin-local-addr: "127.0.0.1:8080";

    in-out property <int> edit-cert-source-index: 1;
    in-out property <int> edit-cert-library-index: 0;
    in property <[string]> cert-library-labels;
    in-out property <string> edit-plugin-cert-file: "";
    in-out property <string> edit-plugin-key-file: "";
    in-out property <string> edit-plugin-host-rewrite: "";
    in-out property <string> edit-plugin-username: "";
    in-out property <string> edit-plugin-password: "";
    in-out property <int> edit-type-index: 0;
    in-out property <bool> show-advanced: false;

    private property <bool> is-tcp-udp: root.edit-type-index <= 1;
    private property <bool> is-socks5: root.edit-type-index == 4;
    private property <bool> is-http: root.edit-type-index == 2;
    private property <bool> is-https: root.edit-type-index == 3;
    private property <bool> is-domain: root.edit-type-index == 2 || root.edit-type-index == 3;
    private property <bool> use-plugin: root.is-https && root.edit-plugin-tls-term;
    private property <bool> use-cert-library: root.use-plugin && root.edit-cert-source-index == 0;
    private property <bool> use-cert-file: root.use-plugin && root.edit-cert-source-index == 1;

    callback save-clicked;
    callback cancel-clicked;
    callback pick-file(string);

    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 14px;
    drop-shadow-color: Theme.shadow;
    drop-shadow-offset-y: 4px;
    vertical-stretch: 0;
    width: 100%;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: stretch;

        HorizontalLayout {
            height: 36px;
            vertical-stretch: 0;
            spacing: 12px;

            Text {
                text: root.editing-index >= 0 ? Tr.tunnel-edit-title : Tr.tunnel-add-title;
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                horizontal-alignment: left;
            }
            Button {
                text: Tr.cancel;
                height: 32px;
                vertical-stretch: 0;
                clicked => { root.cancel-clicked(); }
            }
            Button {
                text: Tr.save;
                primary: true;
                height: 32px;
                vertical-stretch: 0;
                clicked => { root.save-clicked(); }
            }
        }

        FormRow {
            FormField {
                label: Tr.tunnel-name;
                value <=> root.edit-name;
                placeholder: Tr.tunnel-name-hint;
            }
            FormCombo {
                label: Tr.tunnel-type;
                model: ["TCP", "UDP", "HTTP", "HTTPS", "SOCKS5"];
                current-index <=> root.edit-type-index;
            }
        }

        if root.is-tcp-udp: FormRow {
            FormField {
                label: Tr.tunnel-local-port;
                value <=> root.edit-local-port;
                placeholder: "8080";
            }
            FormField {
                label: Tr.tunnel-remote-port;
                value <=> root.edit-remote-port;
                placeholder: "9000";
            }
        }

        if root.is-socks5: FormField {
            label: Tr.tunnel-remote-port;
            value <=> root.edit-remote-port;
            placeholder: "9000";
        }

        if root.is-socks5: FormRow {
            FormField {
                label: Tr.tunnel-plugin-username;
                value <=> root.edit-plugin-username;
            }
            FormField {
                label: Tr.tunnel-plugin-password;
                value <=> root.edit-plugin-password;
            }
        }

        if root.is-http: FormRow {
            FormField {
                label: Tr.tunnel-local-port;
                value <=> root.edit-local-port;
                placeholder: "80";
            }
            FormField {
                label: Tr.tunnel-domains;
                value <=> root.edit-domains;
                placeholder: Tr.tunnel-domains-hint;
            }
        }

        if root.is-https: FormRow {
            FormField {
                label: Tr.tunnel-local-port;
                value <=> root.edit-local-port;
                placeholder: root.use-plugin ? "8080" : "443";
            }
            FormField {
                label: Tr.tunnel-domains;
                value <=> root.edit-domains;
                placeholder: Tr.tunnel-domains-hint;
            }
        }

        TouchArea {
            mouse-cursor: pointer;
            vertical-stretch: 0;
            height: 24px;
            clicked => { root.show-advanced = !root.show-advanced; }
            Text {
                text: root.show-advanced ? Tr.hide-advanced : Tr.show-advanced;
                color: Theme.accent;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: left;
            }
        }

        if root.show-advanced: VerticalLayout {
            spacing: 12px;
            vertical-stretch: 0;
            alignment: stretch;

            if root.is-http: VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                alignment: stretch;

                FormRow {
                    FormField {
                        label: Tr.tunnel-basic-auth-user;
                        value <=> root.edit-basic-auth-user;
                        placeholder: Tr.optional;
                    }
                    FormField {
                        label: Tr.tunnel-basic-auth-password;
                        value <=> root.edit-basic-auth-password;
                        placeholder: Tr.optional;
                    }
                }
                FormRow {
                    FormField {
                        label: Tr.tunnel-locations;
                        value <=> root.edit-locations;
                        placeholder: Tr.tunnel-locations-hint;
                    }
                    FormField {
                        label: Tr.tunnel-host-rewrite;
                        value <=> root.edit-host-header-rewrite;
                        placeholder: Tr.tunnel-host-rewrite-hint;
                    }
                }
            }

            if root.is-https: VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                alignment: stretch;

                Rectangle {
                    height: 36px;
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    background: transparent;

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: 10px;
                        Text {
                            text: Tr.tunnel-tls-term;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }
                        Switch {
                            checked <=> root.edit-plugin-tls-term;
                            vertical-stretch: 0;
                            horizontal-stretch: 0;
                        }
                    }
                }

                if root.edit-plugin-tls-term: VerticalLayout {
                    spacing: 12px;
                    vertical-stretch: 0;
                    alignment: stretch;
                    FormRow {
                        FormField {
                            label: Tr.tunnel-local-ip;
                            value <=> root.edit-local-ip;
                            placeholder: "127.0.0.1";
                        }
                        FormField {
                            label: Tr.tunnel-host-rewrite;
                            value <=> root.edit-plugin-host-rewrite;
                            placeholder: Tr.tunnel-host-rewrite-hint;
                        }
                    }
                    FormRow {
                        FormCombo {
                            label: Tr.tunnel-cert-source;
                            model: [Tr.tunnel-cert-library, Tr.tunnel-cert-file, Tr.tunnel-cert-self];
                            current-index <=> root.edit-cert-source-index;
                        }
                        if root.use-cert-library: FormCombo {
                            label: Tr.tunnel-cert-pick;
                            model: root.cert-library-labels;
                            current-index <=> root.edit-cert-library-index;
                        }
                    }
                    if root.use-cert-file: FormRow {
                        FormPathField {
                            label: Tr.tunnel-plugin-cert;
                            value <=> root.edit-plugin-cert-file;
                            placeholder: Tr.optional;
                            browse-clicked => {
                                root.pick-file("plugin-cert");
                            }
                        }
                        FormPathField {
                            label: Tr.tunnel-plugin-key;
                            value <=> root.edit-plugin-key-file;
                            placeholder: Tr.optional;
                            browse-clicked => {
                                root.pick-file("plugin-key");
                            }
                        }
                    }
                }
            }

            if root.is-tcp-udp || root.is-http || (root.is-https && !root.use-plugin): FormRow {
                FormField {
                    label: Tr.tunnel-local-ip;
                    value <=> root.edit-local-ip;
                    placeholder: "127.0.0.1";
                }
                FormField {
                    label: Tr.tunnel-bandwidth;
                    value <=> root.edit-bandwidth-limit;
                    placeholder: Tr.tunnel-bandwidth-hint;
                }
            }

            if root.is-https && root.use-plugin: FormRow {
                FormField {
                    label: Tr.tunnel-bandwidth;
                    value <=> root.edit-bandwidth-limit;
                    placeholder: Tr.tunnel-bandwidth-hint;
                }
                FormCombo {
                    label: Tr.tunnel-bandwidth-side;
                    model: ["client", "server"];
                    current-index <=> root.edit-bandwidth-side-index;
                }
            }

            if root.is-socks5: FormRow {
                FormField {
                    label: Tr.tunnel-bandwidth;
                    value <=> root.edit-bandwidth-limit;
                    placeholder: Tr.tunnel-bandwidth-hint;
                }
                FormCombo {
                    label: Tr.tunnel-bandwidth-side;
                    model: ["client", "server"];
                    current-index <=> root.edit-bandwidth-side-index;
                }
            }

            if root.is-tcp-udp || root.is-http || (root.is-https && !root.use-plugin): FormRow {
                FormCombo {
                    label: Tr.proxy-protocol;
                    model: [Tr.proxy-protocol-off, "v1", "v2"];
                    current-index <=> root.edit-proxy-protocol-index;
                }
                FormCombo {
                    label: Tr.tunnel-bandwidth-side;
                    model: ["client", "server"];
                    current-index <=> root.edit-bandwidth-side-index;
                }
            }

            if root.is-socks5: FormCombo {
                label: Tr.proxy-protocol;
                model: [Tr.proxy-protocol-off, "v1", "v2"];
                current-index <=> root.edit-proxy-protocol-index;
            }
        }
    }
}
